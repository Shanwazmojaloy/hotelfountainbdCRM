#!/usr/bin/env bash
# Hotel Fountain — pre-commit hook
# Enables: scripts/guard-onedrive-truncation.sh    (file corruption guard)
#          scripts/check-edge-allowlist.mjs        (middleware edge-404 allowlist guard)
#          scripts/check-edge-mail-invariants.mjs  (H-12 dead-mailer ratchet)
#          scripts/check-edge-deploy-manifest.mjs  (edge source vs what is deployed)
# Install: git config core.hooksPath .githooks
set -e
TOP="$(git rev-parse --show-toplevel)"
bash "$TOP/scripts/guard-onedrive-truncation.sh"
# Edge allowlist guard: new routes/public files MUST be in middleware.ts EDGE_EXACT/
# EDGE_PREFIXES or they 404 in production (edge bot-probe defense, commit 6641b63).
# Only runs when relevant paths are staged; node missing → warn-only (never brick a commit).
if git diff --cached --name-only | grep -qE '^(app/|public/|middleware\.ts|vercel\.json)'; then
  if command -v node >/dev/null 2>&1; then
    node "$TOP/scripts/check-edge-allowlist.mjs"
  else
    echo "! node not found — skipping edge-allowlist guard (verify middleware.ts manually)"
  fi
fi
# Supabase edge functions do not deploy from git, so the repo and prod can disagree
# indefinitely with nothing complaining — that is how the H-12 mail outage survived
# six weeks and how the 2026-08-15 audit came to overstate four criticals.
if git diff --cached --name-only | grep -qE '^supabase/functions/'; then
  if command -v node >/dev/null 2>&1; then
    node "$TOP/scripts/check-edge-mail-invariants.mjs"
    node "$TOP/scripts/check-edge-deploy-manifest.mjs"
  else
    echo "! node not found — skipping edge mail/deploy guards (verify DEPLOYED.json manually)"
  fi
fi
# Typecheck gate. 2026-08-15: 95feabe reached main carrying two TS2322 errors in
# src/services/supabase.ts, so `pnpm run vercel-build` exited 1 and NOTHING deployed for
# 53 minutes — while that same commit's REVOKE on leads/corporate_leads was already live
# in Postgres. Production ran post-revoke grants against pre-revoke code the whole time.
# `tsc --noEmit` catches exactly that class of error in under a minute, locally, before it
# can reach main. Same conventions as the guards above: runs only when TS/TSX is staged,
# and is warn-only when the toolchain is absent so a commit is never bricked.
#
# NOTE this checks the WORKING TREE, not the staged snapshot. If you commit a subset of
# your changes it can pass on code you did not stage. That is a deliberate trade: the
# stash-based exact check is slower and stashing has corrupted files on this F: mount
# before (see write_tool_nul_padding). Read a pass as "the tree compiles".
if git diff --cached --name-only | grep -qE '\.(ts|tsx)$'; then
  if [ -x "$TOP/node_modules/.bin/tsc" ]; then
    echo "→ typecheck (tsc --noEmit) …"
    if ! "$TOP/node_modules/.bin/tsc" --noEmit -p "$TOP/tsconfig.json"; then
      echo ""
      echo "✗ typecheck FAILED — this is the exact failure that breaks the Vercel build."
      echo "  Fix it, or override deliberately with: git commit --no-verify"
      exit 1
    fi
    echo "✓ typecheck clean"
  else
    echo "! node_modules/.bin/tsc not found — skipping typecheck (run 'npm run typecheck' manually)"
  fi
fi
