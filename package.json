{
    "name": "hotel-fountain-crm",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "npm run build:crm && next build",
        "vercel-build": "next build",
        "start": "next start",
        "lint": "next lint",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "build:crm": "babel public/crm-src.jsx --config-file ./babel.crm.json --out-file public/crm-bundle.js && terser public/crm-bundle.js --compress --mangle --output public/crm-bundle.js && node scripts/bump-cache.js",
        "import:leads": "node scripts/import-vibe-leads.js"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@supabase/ssr": "^0.10.2",
        "@supabase/supabase-js": "^2.105.1",
        "@tanstack/react-query": "^5.56.2",
        "@tanstack/react-query-devtools": "^5.56.2",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "axios": "^1.7.7",
        "bcryptjs": "^2.4.3",
        "dotenv": "^16.4.5",
        "framer-motion": "^11.11.17",
        "googleapis": "^144.0.0",
        "gsap": "^3.12.5",
        "imapflow": "^1.0.162",
        "next": "^15.0.4",
        "nodemailer": "^9.0.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "satori-html": "^0.3.2",
        "sharp": "^0.34.5",
        "workflow": "^4.6.0"
    },
    "devDependencies": {
        "@babel/cli": "^7.23.5",
        "@babel/core": "^7.23.5",
        "@babel/preset-react": "^7.23.5",
        "@tailwindcss/postcss": "^4.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^20.14.0",
        "@types/nodemailer": "^8.0.1",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "eslint": "^9.0.0",
        "eslint-config-next": "^15.0.4",
        "tailwindcss": "^4.0.0",
        "terser": "^5.31.0",
        "typescript": "^5.5.0",
        "vitest": "^1.6.0"
    },
    "overrides": {
        "nodemailer": "^9.0.3"
    }
}
