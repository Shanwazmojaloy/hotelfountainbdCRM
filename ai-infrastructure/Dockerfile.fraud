# Fraud detection ingestion / scoring worker
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install deps first for layer caching
COPY requirements-fraud.txt .
RUN pip install --no-cache-dir -r requirements-fraud.txt

COPY fraud_ingestion_worker.py .

# Run as non-root
RUN useradd --create-home --uid 10001 appuser
USER appuser

# Default: run the mock demo. In prod, override CMD to start the real
# consumer/scoring loop, e.g. an asyncio entrypoint or gunicorn/uvicorn app.
CMD ["python", "fraud_ingestion_worker.py"]
